# Copier ce fichier en .env (ignoré par Git) puis ajuster. Valeurs locales sans secret.

# Application (toutes optionnelles : voir src/core/config/env.validation.ts)
NODE_ENV=development
APP_NAME=sport-hub-back
APP_HOST=localhost
APP_PORT=3000
APP_GLOBAL_PREFIX=api
# verbose | debug | log | warn | error | fatal
APP_LOG_LEVEL=log
APP_CORS_ORIGIN=http://localhost:4200

# Base de données (toutes obligatoires, lues aussi par docker-compose.yml)
DB_NAME=sporthub
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sporthub
DB_PASSWORD=sporthub
# Lue par Prisma : doit correspondre aux variables DB_* (vérifié au démarrage).
# Écrite en clair : la CLI Prisma n'étend pas les ${variables}.
DATABASE_URL=postgresql://sporthub:sporthub@localhost:5432/sporthub
