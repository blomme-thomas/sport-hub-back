generator client {
  provider = "prisma-client"
  output   = "../src/core/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id               String   @id @default(uuid()) @db.Uuid
  garminActivityId String   @unique @map("garmin_activity_id")
  type             String
  startedAt        DateTime @map("started_at") @db.Timestamptz(3)
  durationSeconds  Float    @map("duration_seconds")
  distanceMeters   Float?   @map("distance_meters")
  rawPayload       Json     @map("raw_payload") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([type, startedAt])
  @@map("activities")
}

model Slot {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  date        DateTime @db.Date
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  recurrence  String   @default("aucune")
  timeZone    String   @map("time_zone")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([date])
  @@index([recurrence, date])
  @@map("slots")
}

model Goal {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  type              String
  targetDate        DateTime? @map("target_date") @db.Date
  eventFormat       String?   @map("event_format")
  targetTimeSeconds Int?      @map("target_time_seconds")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([targetDate])
  @@map("goals")
}

model Discipline {
  id          String   @id @default(uuid()) @db.Uuid
  typeKey     String   @unique @map("type_key")
  label       String
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("disciplines")
}

model Session {
  id                String               @id @default(uuid()) @db.Uuid
  date              DateTime             @db.Date
  disciplineTypeKey String               @map("discipline_type_key")
  durationMinutes   Int                  @map("duration_minutes")
  status            String               @default("planifiee")
  modifiedManually  Boolean              @default(false) @map("modified_manually")
  description       String?
  equipment         String?
  attentionPoints   String?              @map("attention_points")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  modules           SessionModule[]
  changeLogs        SessionChangeLog[]
  activityLink      SessionActivityLink?

  @@index([date])
  @@index([status, date])
  @@map("sessions")
}

model SessionModule {
  id              String  @id @default(uuid()) @db.Uuid
  sessionId       String  @map("session_id") @db.Uuid
  position        Int
  type            String
  durationMinutes Int     @map("duration_minutes")
  instruction     String
  targetZones     Json?   @map("target_zones") @db.JsonB
  perceivedEffort Int?    @map("perceived_effort")
  session         Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@map("session_modules")
}

model SessionChangeLog {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  changedAt     DateTime @map("changed_at") @db.Timestamptz(3)
  field         String
  previousValue String?  @map("previous_value")
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, changedAt])
  @@map("session_change_logs")
}

model SessionActivityLink {
  sessionId  String   @id @map("session_id") @db.Uuid
  activityId String   @unique @map("activity_id") @db.Uuid
  origin     String
  linkedAt   DateTime @map("linked_at") @db.Timestamptz(3)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_activity_links")
}

model ActivityComment {
  activityId  String   @id @map("activity_id") @db.Uuid
  text        String
  source      String
  model       String?
  generatedAt DateTime @map("generated_at") @db.Timestamptz(3)

  @@map("activity_comments")
}

model WeeklyReview {
  week           String   @id @db.VarChar(8)
  suivi          String
  pointAttention String   @map("point_attention")
  conseil        String
  source         String
  model          String?
  generatedAt    DateTime @map("generated_at") @db.Timestamptz(3)

  @@map("weekly_reviews")
}

model Pause {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([startDate, endDate])
  @@map("pauses")
}
