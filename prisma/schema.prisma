generator client {
  provider = "prisma-client"
  output   = "../src/core/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id               String   @id @default(uuid()) @db.Uuid
  garminActivityId String   @unique @map("garmin_activity_id")
  type             String
  startedAt        DateTime @map("started_at") @db.Timestamptz(3)
  durationSeconds  Float    @map("duration_seconds")
  distanceMeters   Float?   @map("distance_meters")
  rawPayload       Json     @map("raw_payload") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([type, startedAt])
  @@map("activities")
}
