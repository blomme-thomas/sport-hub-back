{
  "name": "sport-hub-back",
  "version": "0.0.1",
  "description": "API NestJS (architecture hexagonale / DDD) qui synchronise les données Garmin Connect, calcule les statistiques d'entraînement et génère des séances par IA.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "openapi:generate": "nest build && node dist/openapi/generate-openapi.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@garmin/fitsdk": "^21.222.0",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "4.4.0",
    "dotenv": "^18.0.10",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "ical.js": "^2.2.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "effect": "3.22.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@scarf/scarf": false
  }
}
